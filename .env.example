# Chiave Google Maps Platform con Map Tiles API abilitata (chiave browser).
# Inserisci il valore reale in .env.local (mai committato); dopo la modifica
# riavvia il server di sviluppo. Limita la chiave per HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# Provider della sorgente dati 3D: 'google' (default del codice: Map Tiles API
# diretta con la chiave utente; quota Google per progetto 150 root request/min,
# fonte dell'errore 429 RATE_LIMIT_EXCEEDED) oppure 'google-ion' (consigliato:
# passa SOLO da Cesium ion, asset 2275207, chiave Google gestita da ion;
# richiede VITE_CESIUM_ION_TOKEN). Alias accettato: 'cesium' = 'google-ion'.
# Override runtime senza rebuild: ?provider=google|google-ion nell'URL.
VITE_SCENE_PROVIDER=

# Token Cesium ion (richiesto SOLO per il provider 'google-ion'): crealo su
# https://ion.cesium.com/tokens (account Community gratuito), limitandolo agli
# asset usati: Google Photorealistic 3D Tiles (asset 2275207). Finisce nel
# bundle: è un token browser, va protetto con le restrizioni di asset consentiti
# dalla console ion.
VITE_CESIUM_ION_TOKEN=
