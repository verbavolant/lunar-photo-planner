# Chiave Google Maps Platform con Map Tiles API abilitata (chiave browser).
# Inserisci il valore reale in .env.local (mai committato); dopo la modifica
# riavvia il server di sviluppo. Limita la chiave per HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# Provider della sorgente dati 3D: 'google' (default) oppure 'cesium'.
# Override runtime senza rebuild: ?provider=cesium / ?provider=google nell'URL.
VITE_SCENE_PROVIDER=

# Token Cesium ion (richiesto SOLO per il provider 'cesium'): crealo su
# https://ion.cesium.com/tokens (account Community gratuito), limitandolo agli
# asset usati. Finisce nel bundle: è un token browser, va protetto con le
# restrizioni di asset consentiti dalla console ion.
VITE_CESIUM_ION_TOKEN=
